  .hero-shade{bottom:auto;height:calc(min(92vw,66svh) + 1px);background:linear-gradient(180deg,rgba(18,9,6,.5) 0,rgba(18,9,6,0) 24%,rgba(18,9,6,0) 74%,var(--night) 100%)}
  .hero-copy{padding-block:6px 42px}
  .hero-text{width:100%}
  .friend,.taste{grid-template-columns:minmax(0,1fr)}
  .friend-copy,.taste-copy{padding-left:var(--gx-l);padding-right:var(--gx-r)}
  .friend-media{order:-1;min-height:112vw}
  .taste-media{min-height:96vw}
  .stats{grid-template-columns:minmax(0,1fr)}
  .box-stage{grid-template-columns:minmax(0,1fr);gap:18px}
  .scene{--h:min(42svh,360px);order:-1}
  .box-head h2{font-size:27px}
  .box-head .lede{display:none}
  .pin .box-stage{padding-block:66px 16px;gap:8px}
  .pin .box-head{margin-bottom:12px;gap:6px}
  .pin .box-caps{min-height:238px}
  .box-cap .big{font-size:18px}
  .box-cap li{font-size:14px}
  .box-cap{gap:8px}.box-cap ul{gap:5px}
  .ing>img{object-position:78% center;height:62%}
  .ing{align-items:flex-end}
  .ing::before{background:linear-gradient(180deg,rgba(18,9,6,0) 34%,var(--night) 62%)}
  .ing-copy{padding-bottom:calc(92px + env(safe-area-inset-bottom,0px))}
  .keep{display:none}
  .ing-name{font-size:clamp(32px,10.4vw,48px)}
  .ben,.ben:nth-of-type(even){grid-template-columns:minmax(0,1fr)}
  .ben:nth-of-type(even) figure{order:0}
  .ritual .inner{grid-template-columns:minmax(0,1fr)}
  .ritual-sachet{display:none}
  .steps{grid-template-columns:minmax(0,1fr)}
  .ticks{grid-template-columns:minmax(0,1fr)}
  .cards{grid-template-columns:minmax(0,1fr)}
  .card.star{order:-1}
  .label-cols{grid-template-columns:minmax(0,1fr)}
  .buy .inner{grid-template-columns:minmax(0,1fr)}
  .buy-art{order:-1}
  .buy .btn{width:100%}
  .float{left:max(16px,env(safe-area-inset-left,0px));right:max(16px,env(safe-area-inset-right,0px))}
  .nav img{width:112px}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .rv-on .rv{transform:none;transition:none}
}

/* ===== Christmas layer: velvet, pine, tartan, kraft and gold foil across the whole page ===== */
:root{
  --pine:#10261A; --pine-2:#17352A; --velvet:#5A0808; --velvet-lit:#7E0D0D;
  --foil:linear-gradient(100deg,#F9E3A6 0%,#D9A94F 38%,#FFF0C2 58%,#C8913A 100%);
  --gold-lit:#EBCB86; --paper:#FBF0DA;
  --velvet-bg:linear-gradient(rgba(58,4,4,.66),rgba(44,3,3,.76)),url("https://cdn.shopify.com/s/files/1/0653/9984/9200/files/tnl-velvet.webp") center/cover;
  --gold:#E2BE78; --line:rgba(226,190,120,.42);
}
body{background:var(--pine)}
.grain{opacity:.05}
h1 em,h2 em{background:var(--foil);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;padding-right:.04em}
.on-paper h2 em{background:none;color:var(--red);-webkit-text-fill-color:var(--red)}
.btn{background:var(--foil);background-size:160% 100%;color:#3A0606;border:0;font-weight:700;box-shadow:0 8px 24px rgba(0,0,0,.34),inset 0 0 0 1px rgba(255,255,255,.4);transition:background-position .5s,transform .25s,box-shadow .25s}
.btn:hover{background:var(--foil);background-size:160% 100%;background-position:100% 0;transform:translateY(-2px);box-shadow:0 12px 34px rgba(235,190,100,.42)}
.card .btn.ghost{background:transparent;color:var(--cream);box-shadow:inset 0 0 0 1px var(--line)}
.card .btn.ghost:hover{background:rgba(226,190,120,.16)}
.tartan{position:relative;z-index:3;height:clamp(16px,1.8vw,26px);background:url("https://cdn.shopify.com/s/files/1/0653/9984/9200/files/tnl-tartan.webp") center/auto 300%;box-shadow:0 2px 12px rgba(0,0,0,.45),inset 0 1px 0 rgba(255,235,190,.35),inset 0 -1px 0 rgba(255,235,190,.35)}
.bb{position:absolute;z-index:4;top:0;left:var(--x,auto);right:var(--r,auto);width:var(--w,64px);padding-top:var(--len,90px);transform-origin:50% 0;animation:sway var(--t,5.2s) ease-in-out infinite;pointer-events:none}
.bb::before{content:"";position:absolute;top:0;left:50%;width:1px;height:calc(var(--len,90px) + 6px);background:linear-gradient(rgba(240,210,150,.9),rgba(240,210,150,.65))}
.bb img{position:relative;width:100%;height:auto;filter:drop-shadow(0 12px 16px rgba(0,0,0,.45))}
@keyframes sway{0%,100%{transform:rotate(-2.6deg)}50%{transform:rotate(2.6deg)}}
#snow{position:fixed;top:0;left:0;width:100%;height:100vh;height:100lvh;z-index:55;pointer-events:none}

/* nav: a velvet pelmet with old-fashioned bulbs hanging under it */
.nav,.nav.on{background:linear-gradient(#6E0B0B,#4C0606);border-bottom:2px solid var(--gold);backdrop-filter:none;-webkit-backdrop-filter:none}
body::before{background:#6E0B0B}
.nav .btn{box-shadow:none}
.nav-right{display:flex;align-items:center;gap:10px}
.sound{width:38px;height:38px;border-radius:50%;border:1px solid var(--gold);background:rgba(0,0,0,.18);color:var(--gold-lit);display:grid;place-items:center;cursor:pointer;padding:0;transition:background .25s}
.sound:hover,.sound[aria-pressed="true"]{background:var(--gold);color:#3A0606}
.sound svg{width:18px;height:18px}
.nav-lights{position:absolute;left:0;right:0;top:100%;height:30px;width:100%;overflow:visible;pointer-events:none}
.nav-lights path{fill:none;stroke:#2c1a10;stroke-width:1.6}
.nav-lights circle{animation:tw 2.8s ease-in-out infinite}
.nav-lights .halo{animation:none;opacity:.22}
.float{box-shadow:0 10px 30px rgba(0,0,0,.5)}

/* hero */
.hero{background:var(--velvet-bg);min-height:min(100svh,940px)}
.hero-shade{background:linear-gradient(90deg,rgba(76,6,6,0) 32%,rgba(76,6,6,.62) 54%,rgba(62,5,5,.93) 76%),linear-gradient(180deg,rgba(40,4,4,.3) 0,rgba(40,4,4,0) 24%)}
.hero-copy{padding-block:clamp(120px,10vw,150px) 72px}
.days{background:rgba(30,3,3,.55);border:1px solid var(--gold);box-shadow:inset 0 0 0 3px rgba(30,3,3,.55),inset 0 0 0 4px rgba(226,190,120,.5);padding:9px 14px}
.days b{color:var(--gold-lit)}
.stars{color:#F3CF7F}
.eyebrow{color:var(--gold-lit)}
.lede,.body{color:rgba(254,244,226,.86)}

/* december problem: pine green */
.problem{position:relative;z-index:2;background:radial-gradient(ellipse 80% 50% at 30% 8%,rgba(60,110,76,.34),transparent 70%),var(--pine);padding-top:0;overflow:clip}
.problem .inner{position:relative;z-index:2}
.times{gap:clamp(12px,1.4vw,20px);border:0}
.times li,.times li+li{border:1px solid var(--gold);background:rgba(7,22,14,.62);box-shadow:inset 0 0 0 4px rgba(7,22,14,.62),inset 0 0 0 5px rgba(226,190,120,.42)}
.times time{color:var(--gold-lit)}
.stats{border-top:1px solid var(--line)}
.bignum{background:var(--foil);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;width:max-content;padding-right:.1em}
.src{color:rgba(254,244,226,.68)}

/* friend: red velvet */
.friend{position:relative;z-index:2;background:var(--velvet-bg)}
.friend-media{box-shadow:inset 0 0 0 1px var(--gold)}
.chips li{border-color:var(--gold);color:var(--cream)}
.friend-media video{border-left:2px solid var(--gold)}

/* turning box: tree-green room with soft lights */
.boxsec{z-index:2;background:var(--pine)}
.box-sticky{background:radial-gradient(circle 4px at 11% 20%,rgba(255,214,140,.8),transparent 100%),radial-gradient(circle 60px at 8% 78%,rgba(255,190,90,.12),transparent),radial-gradient(circle 90px at 48% 14%,rgba(255,190,90,.1),transparent),radial-gradient(circle 46px at 58% 84%,rgba(255,190,90,.14),transparent),radial-gradient(circle 70px at 94% 18%,rgba(255,190,90,.12),transparent),radial-gradient(circle 54px at 90% 88%,rgba(255,190,90,.14),transparent),radial-gradient(ellipse 34% 62% at 72% 52%,rgba(152,12,12,.5),transparent 75%),radial-gradient(ellipse 80% 80% at 40% 40%,#1C4030,var(--pine) 80%)}
.pin .box-stage{padding-block:128px 26px}
.box-cap .where{color:var(--gold-lit)}
.box-dots i.on{background:var(--gold-lit)}

/* ingredients */
.ing-head{position:relative;z-index:2;background:var(--velvet-bg)}
.ing{background:var(--velvet);box-shadow:0 -8px 26px rgba(0,0,0,.45);border-top:2px solid var(--gold)}
.ing::before{background:linear-gradient(90deg,rgba(62,5,5,.94) 0,rgba(62,5,5,.78) 34%,rgba(62,5,5,0) 62%)}
.ing-count,.ing-role{color:var(--gold-lit)}
.ing-sub{color:var(--gold-lit)}

/* taste: cream paper */
.taste{background:var(--paper);color:var(--ink);border-top:2px solid var(--gold)}
.taste .eyebrow{color:var(--red)}
.taste h2{color:#3A0606}
.taste .lede{color:var(--ink-dim)}
.taste-list{background:rgba(152,12,12,.3);border-color:rgba(152,12,12,.3)}
.taste-list li{background:var(--paper)}
.taste-list b{color:var(--red)}

/* benefits: framed like Christmas cards on velvet */
.benefits{background:var(--velvet-bg)}
.ben figure{position:relative;overflow:visible;background:var(--paper);padding:clamp(8px,1vw,14px);box-shadow:0 22px 44px rgba(20,0,0,.55);aspect-ratio:auto;transition:transform .5s}
.ben figure img{aspect-ratio:3/2;box-shadow:0 0 0 1px rgba(201,163,106,.9)}
.ben:nth-of-type(odd) figure{transform:rotate(-1deg)}
.ben:nth-of-type(even) figure{transform:rotate(1deg)}
.ben figure:hover{transform:rotate(0) scale(1.012)}
.ben-copy .lab{color:var(--gold-lit)}

/* ritual: wrapped in kraft paper and red ribbon */
.ritual{background:url("https://cdn.shopify.com/s/files/1/0653/9984/9200/files/tnl-kraft.webp") center/cover;padding-block:var(--sec);overflow:clip}
.ritual .eyebrow{color:#7C0A0A}
.ritual h2{color:#7C0A0A}
.ritual-sub,.steps p{color:#3A2112}
.ritual .wrap{position:relative;z-index:2}

/* for you: gift tags on pine */
.foryou{background:radial-gradient(ellipse 70% 50% at 70% 10%,rgba(60,110,76,.3),transparent 70%),var(--pine);overflow:clip}
.foryou .inner{position:relative;z-index:2}
.ticks{gap:clamp(18px,2.2vw,30px);background:none;border:0}
.ticks li{position:relative;background:var(--paper);color:var(--ink);padding:clamp(34px,3vw,42px) clamp(20px,2.2vw,30px) clamp(22px,2.2vw,30px);clip-path:polygon(26px 0,calc(100% - 26px) 0,100% 26px,100% 100%,0 100%,0 26px)}
.ticks li::before{content:"";position:absolute;top:12px;left:50%;width:13px;height:13px;margin-left:-6px;border-radius:50%;background:var(--pine);box-shadow:0 0 0 2px var(--gold)}
.ticks-wrap{display:contents}
.ticks li:nth-child(3n+1){transform:rotate(-.7deg)}
.ticks li:nth-child(3n){transform:rotate(.7deg)}
.ticks .body{color:var(--ink-dim)}
.tick{color:var(--red)}
.foryou-end p{color:var(--cream)}

/* range */
.range{position:relative;background:var(--velvet-bg);overflow:clip}
.range .inner{position:relative;z-index:5}
.card{background:rgba(12,32,22,.92);border-color:var(--gold);position:relative}
.card.star{background:linear-gradient(170deg,#9E1010,#4C0606 72%);border:1px solid var(--gold-lit);box-shadow:inset 0 0 0 1px var(--gold-lit)}
.flag{background:var(--foil);color:#3A0606;transform:translate(-50%,-50%)}
.card dt{color:rgba(254,244,226,.68)}

/* versus: a paper list on pine */
.versus{background:var(--pine)}
.tbl{background:var(--paper);color:var(--ink);border:0;box-shadow:0 26px 50px rgba(0,0,0,.5);transform:rotate(-.35deg);border-top:14px solid transparent;border-image:url("https://cdn.shopify.com/s/files/1/0653/9984/9200/files/tnl-tartan.webp") 40 0 0 0 stretch}
.tbl th,.tbl td{border-color:rgba(74,44,29,.2)}
thead th{color:rgba(42,23,14,.7)}
tbody th{color:var(--ink)}
.us{background:rgba(152,12,12,.1)}
thead .us{color:#7C0A0A}
.y{color:var(--red)}
.n{color:rgba(42,23,14,.42)}

/* reviews: Christmas cards */
.reviews{position:relative;background:var(--velvet-bg);overflow:clip}
.rev-grid{align-items:stretch}
.rev{position:relative;background:var(--paper);color:var(--ink);border:0;padding:clamp(30px,3vw,42px) clamp(22px,2.4vw,32px);outline:1px solid var(--gold);outline-offset:-9px;box-shadow:0 20px 40px rgba(20,0,0,.5)}
.rev:nth-child(1){transform:rotate(-1.1deg)}
.rev:nth-child(3){transform:rotate(1.1deg)}
.rev .stars{color:var(--red)}
.rev cite{color:rgba(42,23,14,.7)}
.reviews .rating .stars{color:#F3CF7F}

/* label */
.label{background:var(--pine)}
.nutri{background:linear-gradient(160deg,#8E0D0D,#520707);box-shadow:0 22px 44px rgba(0,0,0,.42)}
.label-cols h3{color:var(--gold-lit)}
.label-cols p{color:rgba(254,244,226,.86)}

/* faq */
.faq{background:var(--paper);color:var(--ink);overflow:clip}
.faq .inner{position:relative;z-index:2}
.faq .eyebrow{color:var(--red)}
.faq h2{color:#3A0606}
.faq details{border-color:rgba(152,12,12,.3)}
.faq details p{color:var(--ink-dim)}
.faq summary i{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:radial-gradient(circle at 34% 30%,#D93A3A,#8A0D0D 62%);color:var(--cream);font-size:19px;box-shadow:0 3px 6px rgba(80,0,0,.32)}

/* buy */
.buy{background:linear-gradient(rgba(96,6,6,.42),rgba(60,4,4,.5)),url("https://cdn.shopify.com/s/files/1/0653/9984/9200/files/tnl-velvet.webp") center/cover}
.buy .btn{background:var(--foil);color:#3A0606;border:0}
.buy .btn:hover{background:var(--foil);background-size:160% 100%;background-position:100% 0}
.buy .inner{position:relative;z-index:2}
.buy h2 em{color:transparent}
.buy-art .a,.buy-art .b{position:relative}
.buy-art .b{margin-left:-1%}

footer{background:#0A1C13;color:rgba(254,244,226,.68);padding-top:38px}

@media (max-width:980px){
  .times li+li{border-top:1px solid var(--gold)}
}
@media (max-width:760px){
  .hero{background:var(--velvet-bg)}
  .hero-media{height:96vw;max-height:66svh}
  .hero-shade{height:calc(min(96vw,66svh) + 1px);background:linear-gradient(180deg,rgba(40,4,4,.1) 0,rgba(40,4,4,0) 70%,rgba(60,5,5,1) 100%)}
  .hero-copy{padding-block:8px 44px}
  .friend-media video{border-left:0}
  .pin .box-stage{padding-block:104px 16px}
  .ing::before{background:linear-gradient(180deg,rgba(70,6,6,0) 32%,var(--velvet) 62%)}
  .hero .bb{display:none}
  .hero .bb[style*="--r:3%"]{display:block}
  .bb.d{display:none}
  .sound{width:34px;height:34px}
}
@media (prefers-reduced-motion:reduce){
  .bb{animation:none}
  .nav-lights circle{animation:none}
}
</style>
{% endraw %}</head>
