<script>
(function(){
  var reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
  var $=function(id){return document.getElementById(id)};
  var clamp=function(v,a,b){return Math.min(b,Math.max(a,v))};

  /* edit these two values for offer changes */

  /* days to Christmas, in Singapore time */
  (function(){
    var sg=new Date(Date.now()+(8*60+new Date().getTimezoneOffset())*6e4);
    var today=Date.UTC(sg.getFullYear(),sg.getMonth(),sg.getDate());
    var n=Math.round((Date.UTC(2026,11,25)-today)/864e5);
    if(n<0) return;
    $('daysN').textContent=n===0?'Merry':n;
    $('daysL').textContent=n===0?'Christmas':n===1?'day to Christmas':'days to Christmas';
    $('days').hidden=false;
  })();

  /* old-fashioned bulbs hanging under the nav */
  (function(){
    var s=$('navLights'), NS='http://www.w3.org/2000/svg', d='M0 1', spans=9, w=1440/spans, cols=['#FF5A4A','#FFD58A','#4FC27A','#FFB84D'], n=0;
    for(var i=0;i<spans;i++){
      var x0=i*w;
      d+=' Q'+(x0+w/2)+' 26 '+(x0+w)+' 1';
    }
    var p=document.createElementNS(NS,'path');p.setAttribute('d',d);s.appendChild(p);
    for(var j=0;j<spans;j++){
      for(var k=1;k<5;k++){
        var t=k/5, x=j*w+t*w, y=1+(2*t*(1-t))*25+6, col=cols[n%4];
        var h=document.createElementNS(NS,'circle');h.setAttribute('class','halo');h.setAttribute('cx',x);h.setAttribute('cy',y);h.setAttribute('r',9);h.setAttribute('fill',col);s.appendChild(h);
        var c=document.createElementNS(NS,'circle');c.setAttribute('cx',x);c.setAttribute('cy',y);c.setAttribute('r',3.6);c.setAttribute('fill',col);c.style.animationDelay=(-(n*0.61)%2.8).toFixed(2)+'s';s.appendChild(c);n++;
      }
    }
  })();

  /* falling snow and gold flecks on desktop only, phones get none, set SNOW to false to turn it off everywhere */
  var SNOW=true;
  (function(){
    var cv=$('snow');
    if(!SNOW){cv.style.display='none';return}
    var ctx=cv.getContext('2d'),W=0,H=0,dpr=1,flakes=[],last=0;
    var phone=matchMedia('(max-width:760px),(pointer:coarse) and (max-height:500px)');
    function flake(){return {x:Math.random()*W,y:Math.random()*H,r:.8+Math.random()*2,v:.35+Math.random()*.75,p:Math.random()*6.28,g:Math.random()<.16}}
    function size(){
      cv.style.display=phone.matches?'none':'';
      if(phone.matches){W=H=0;flakes=[];return}
      var nw=innerWidth,nh=cv.getBoundingClientRect().height;
      if(nw===W&&Math.abs(nh-H)<2) return;
      W=nw;H=nh;dpr=Math.min(devicePixelRatio||1,2);cv.width=W*dpr;cv.height=H*dpr;
      var n=Math.min(80,Math.round(W/18));
      flakes=[];for(var i=0;i<n;i++)flakes.push(flake());
    }
    function draw(){
      ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,W,H);
      flakes.forEach(function(f){
        ctx.beginPath();ctx.arc(f.x,f.y,f.r,0,6.283);
        ctx.fillStyle=f.g?'rgba(255,214,140,.9)':'rgba(255,255,255,'+Math.min(.95,.5+f.r*.13)+')';ctx.fill();
      });
    }
    function frame(ms){
      requestAnimationFrame(frame);
      if(ms-last<30||!flakes.length)return;last=ms;
      flakes.forEach(function(f){
        f.y+=f.v;f.p+=.012;f.x+=Math.sin(f.p)*.42;
        if(f.y>H+6){f.y=-6;f.x=Math.random()*W}
      });
      draw();
    }
    /* with the Reduce Motion setting on, the snow stays still rather than falling */
    size();draw();
    addEventListener('resize',function(){size();draw()});
    if(!reduce) requestAnimationFrame(frame);
  })();

  /* music box: Jingle Bells (public domain), only starts when the visitor presses play */
  (function(){
    var btn=$('sound'),ac=null,master=null,timer=null,on=false;
    var S=[[76,1],[76,1],[76,2],[76,1],[76,1],[76,2],[76,1],[79,1],[72,1.5],[74,.5],[76,4],[77,1],[77,1],[77,1.5],[77,.5],[77,1],[76,1],[76,1],[76,.5],[76,.5],[76,1],[74,1],[74,1],[76,1],[74,2],[79,2],[76,1],[76,1],[76,2],[76,1],[76,1],[76,2],[76,1],[79,1],[72,1.5],[74,.5],[76,4],[77,1],[77,1],[77,1.5],[77,.5],[77,1],[76,1],[76,1],[76,.5],[76,.5],[79,1],[79,1],[77,1],[74,1],[72,4]];
    var B=.3;
    function note(m,t,len){
      var f=440*Math.pow(2,(m-69)/12);
      [[1,.34],[2,.1],[4,.05]].forEach(function(h){
        var o=ac.createOscillator(),g=ac.createGain();o.type='sine';o.frequency.value=f*h[0];
        g.gain.setValueAtTime(0,t);g.gain.linearRampToValueAtTime(h[1],t+.006);g.gain.exponentialRampToValueAtTime(.0008,t+Math.max(.9,len*1.8));
        o.connect(g);g.connect(master);o.start(t);o.stop(t+Math.max(1,len*1.9));
      });
    }
    function play(){
      var t=ac.currentTime+.08,total=0;
      S.forEach(function(n){note(n[0],t+total,n[1]*B);total+=n[1]*B});
      timer=setTimeout(play,(total+.6)*1000);
    }
    btn.onclick=function(){
      on=!on;btn.setAttribute('aria-pressed',on);btn.setAttribute('aria-label',on?'Stop Christmas music':'Play Christmas music');
      if(on){
        if(!ac){ac=new (window.AudioContext||window.webkitAudioContext)();master=ac.createGain();master.gain.value=.32;master.connect(ac.destination)}
        ac.resume();master.gain.setValueAtTime(.32,ac.currentTime);play();
      }else{clearTimeout(timer);ac.close();ac=null}
    };
  })();

  /* reveal: content is readable before and after, only position moves */
  if(!reduce && 'IntersectionObserver' in window){
    var items=[].filter.call(document.querySelectorAll('.rv'),function(e){return e.getBoundingClientRect().top>innerHeight});
    items.forEach(function(e){e.classList.add('rv-prep')});
    document.documentElement.classList.add('rv-on');
    document.querySelectorAll('.rv').forEach(function(e){if(!e.classList.contains('rv-prep'))e.classList.add('in')});
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{rootMargin:'0px 0px -6% 0px'});
    items.forEach(function(e){io.observe(e)});
  }

  /* hero: the tree lights twinkle and the latte steams, mapped onto the photo */
  (function(){
    var BULBS=[[0.4019, 0.1023], [0.385, 0.1316], [0.4317, 0.1373], [0.4216, 0.145], [0.3986, 0.1632], [0.3869, 0.1718], [0.441, 0.1892], [0.4312, 0.2014], [0.4152, 0.2049], [0.3731, 0.223], [0.4424, 0.2264], [0.3679, 0.2647], [0.4194, 0.266], [0.3864, 0.2761], [0.4337, 0.2788], [0.455, 0.2878], [0.4608, 0.332], [0.4045, 0.3498], [0.3604, 0.357], [0.4583, 0.358], [0.468, 0.3641], [0.4441, 0.3716], [0.3682, 0.3759], [0.4253, 0.3758], [0.442, 0.432], [0.3908, 0.4544], [0.3548, 0.4855], [0.4706, 0.4838], [0.4832, 0.492], [0.3629, 0.4981], [0.4085, 0.5034], [0.4755, 0.514], [0.3867, 0.5194], [0.4175, 0.5231], [0.4391, 0.5338], [0.3927, 0.57], [0.4404, 0.5759], [0.3869, 0.5758], [0.4232, 0.5789], [0.3718, 0.5803], [0.4534, 0.585], [0.4082, 0.5892], [0.3679, 0.59], [0.4441, 0.5901], [0.4295, 0.5977], [0.4438, 0.6132], [0.4182, 0.5993], [0.4981, 0.61], [0.4238, 0.6051], [0.485, 0.6254]];
    var img=('heroImg'),cv=('heroFx'), box=$('heroMedia');
    if(reduce||!cv.getContext) return;
    var ctx=cv.getContext('2d'), W=0,H=0,dpr=1,iw=2200,ih=1228,sc=1,ox=0,oy=0,visible=true,last=0;
    var MUG=[.397,.586], steam=[];
    function fit(){
      var r=box.getBoundingClientRect();dpr=Math.min(devicePixelRatio||1,1.5);W=r.width;H=r.height;cv.width=W*dpr;cv.height=H*dpr;
      var pos=getComputedStyle(img).objectPosition.split(' ').map(parseFloat);
      sc=Math.max(W/iw,H/ih);ox=(W-iw*sc)*(pos[0]/100);oy=(H-ih*sc)*(pos[1]/100);
    }
    function px(f){return [ox+f[0]*iw*sc, oy+f[1]*ih*sc]}
    var seeds=BULBS.map(function(b,i){return {b:b,ph:i*2.399,sp:.55+((i*7)%10)/10*.9}});
    for(var i=0;i<26;i++) steam.push({t:Math.random(),dx:(Math.random()-.5),w:Math.random()*6.28});
    function frame(ms){
      requestAnimationFrame(frame);
      if(!visible||ms-last<33) return; last=ms;
      var t=ms/1000;
      ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,W,H);
      ctx.globalCompositeOperation='lighter';
      var u=iw*sc/1100;
      seeds.forEach(function(s){
        var a=Math.pow(.5+.5*Math.sin(t*s.sp+s.ph),3), q=px(s.b), r=16*u;
        var g=ctx.createRadialGradient(q[0],q[1],0,q[0],q[1],r);
        g.addColorStop(0,'rgba(255,214,150,'+(.62*a)+')');g.addColorStop(1,'rgba(255,170,70,0)');
        ctx.fillStyle=g;ctx.beginPath();ctx.arc(q[0],q[1],r,0,6.283);ctx.fill();
      });
      ctx.globalCompositeOperation='source-over';
      var m=px(MUG);
      steam.forEach(function(s){
        s.t+=.0042;if(s.t>1){s.t=0;s.dx=Math.random()-.5}
        var y=m[1]-s.t*120*u, x=m[0]+s.dx*44*u+Math.sin(s.t*5+s.w)*15*u*s.t, r=(9+s.t*26)*u, a=.085*Math.sin(s.t*3.14);
        var g=ctx.createRadialGradient(x,y,0,x,y,r);g.addColorStop(0,'rgba(255,240,222,'+a+')');g.addColorStop(1,'rgba(255,240,222,0)');
        ctx.fillStyle=g;ctx.beginPath();ctx.arc(x,y,r,0,6.283);ctx.fill();
      });
    }
    fit();addEventListener('resize',fit);
    if('IntersectionObserver' in window)new IntersectionObserver(function(e){visible=e[0].isIntersecting}).observe(box);
    requestAnimationFrame(frame);
  })();

  /* glove film plays once when reached, then rests on the last frame */
  (function(){
    var v=$('glove');
    if(reduce||!('IntersectionObserver' in window)) return;
    new IntersectionObserver(function(es,o){
      if(es[0].isIntersecting){var p=v.play();if(p&&p.catch)p.catch(function(){});o.disconnect()}
    },{threshold:.45}).observe(v);
  })();

  /* turning box */
  var sec=('boxsec'),box=('box3d'), caps=[].slice.call(document.querySelectorAll('.box-cap')), dots=[].slice.call($('boxDots').children), stage=0;
  var pinned=!reduce;
  if(pinned) document.documentElement.classList.add('pin');
  function lerpKeys(p){
    var K=[[0,-14],[.1,-14],[.32,74],[.5,74],[.72,-74],[.9,-74],[1,-58]];
    for(var i=1;i<K.length;i++){if(p<=K[i][0]){var a=K[i-1],b=K[i],t=(p-a[0])/(b[0]-a[0]||1);t=t*t*(3-2*t);return a[1]+(b[1]-a[1])*t}}
    return K[K.length-1][1];
  }
  function drawBox(){
    if(!pinned) return;
    var r=sec.getBoundingClientRect(), p=clamp(-r.top/(r.height-innerHeight),0,1);
    box.style.setProperty('--ry',lerpKeys(p).toFixed(2)+'deg');
    var s=p<.2?0:p<.6?1:2;
    if(s!==stage){stage=s;caps.forEach(function(c,i){c.classList.toggle('on',i===s)});dots.forEach(function(d,i){d.classList.toggle('on',i===s)})}
  }

  /* nav, floating CTA, hero depth, sachet tilt */
  var nav=('nav'),fl=('float'), hm=('heroMedia'),shop=('shop'), sachet=$('ritualSachet'), tick=false;
  function onScroll(){
    tick=false;
    var y=scrollY;
    nav.classList.toggle('on',y>40);
    var br=sec.getBoundingClientRect(), overBox=innerWidth<=760 && br.top<innerHeight*.5 && br.bottom>innerHeight*.5;
    fl.classList.toggle('on',y>innerHeight*.7 && !overBox && shop.getBoundingClientRect().top>innerHeight*.7);
    if(!reduce){
      if(y<innerHeight*1.2) hm.style.transform='translateY('+(y*.1).toFixed(1)+'px) scale('+(1+y*.00007).toFixed(4)+')';
      var sr=sachet.getBoundingClientRect();
      if(sr.bottom>0&&sr.top<innerHeight) sachet.style.transform='rotate('+(7-(sr.top/innerHeight)*12).toFixed(2)+'deg)';
    }
    drawBox();
  }
  addEventListener('scroll',function(){if(!tick){tick=true;requestAnimationFrame(onScroll)}},{passive:true});
  addEventListener('resize',onScroll);
  onScroll();

})();
</script>
