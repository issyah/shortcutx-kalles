{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Find Your Fit Shortcutx</title>
<style>
  :root{
    --red:#9b0d0c; --red-dark:#700a09; --red-deep:#4d0706; --red-light:#c33d3c; --red-pale:#fbebea; --red-pale2:#f5d9d8;
    --white:#FFFFFF; --off:#FAFAFA; --g100:#F2F2F2; --g200:#E6E6E6; --g300:#CCCCCC; --g500:#808080; --g700:#4D4D4D; --g900:#333333;
    --gold:#ffd479;
    --disp:'Gotham','Poppins',sans-serif; --body:'Gotham','Poppins',sans-serif; --mono:'Gotham','Poppins',sans-serif;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{background:var(--white); color:var(--g900); font-family:var(--body); -webkit-font-smoothing:antialiased;}
  a{color:inherit; text-decoration:none;}
  img{max-width:100%; display:block;}
  .wrap{max-width:1120px; margin:0 auto; padding:0 28px;}
  .eyebrow{font-family:var(--mono); font-size:13px; letter-spacing:.16em; text-transform:uppercase; color:var(--red); font-weight:600;}

  /* ---------- hero intro ---------- */
  .fyf-hero{background:var(--red); color:var(--white); padding:64px 0 56px; position:relative; overflow:hidden;}
  .blob{position:absolute; border-radius:50%; filter:blur(80px); opacity:.15; background:var(--white);}
  .blob-a{width:400px; height:400px; top:-180px; right:-120px;}
  .blob-b{width:300px; height:300px; bottom:-160px; left:-100px;}
  .fyf-hero-inner{position:relative; z-index:1; text-align:center; max-width:640px; margin:0 auto;}
  .fyf-kicker{display:flex; justify-content:center; gap:10px; align-items:center; margin-bottom:18px;}
  .stars{color:var(--gold); letter-spacing:2px;}
  .fyf-hero h1{font-family:var(--disp); font-weight:900; font-size:clamp(34px,5.2vw,56px); line-height:1.03; margin-bottom:16px;}
  .fyf-hero p{font-size:16.5px; color:rgba(255,255,255,.85); line-height:1.6; margin-bottom:28px;}

  /* ---------- nutritionist authority ---------- */
  .na-card{
    display:flex; align-items:center; gap:14px; background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.2);
    border-radius:12px; padding:16px 20px; max-width:460px; margin:0 auto 12px; text-align:left;
  }
  .na-avatar{width:44px; height:44px; min-width:44px; border-radius:50%; background:rgba(255,255,255,.15); display:flex; align-items:center; justify-content:center; font-size:20px;}
  .na-name{font-weight:700; font-size:14.5px; color:var(--white); display:flex; align-items:center; gap:8px;}
  .na-check{font-family:var(--mono); font-size:10.5px; font-weight:700; color:var(--gold); background:rgba(255,212,121,.15); padding:2px 8px; border-radius:10px;}
  .na-cred{font-size:12.5px; color:rgba(255,255,255,.65); margin-top:3px;}

  .fyf-stats{display:flex; justify-content:center; gap:28px; margin-top:30px; flex-wrap:wrap;}
  .fyf-stat{text-align:center;}
  .fyf-stat .n{font-family:var(--disp); font-weight:900; font-size:22px; color:var(--white);}
  .fyf-stat .l{font-family:var(--mono); font-size:11.5px; color:rgba(255,255,255,.65); margin-top:2px;}

  /* ---------- quiz section ---------- */
  .fyf-quiz-section{background:var(--off); padding:64px 0 90px;}
  .quiz-card{
    background:var(--white); border:1px solid var(--g200); border-radius:16px; padding:40px;
    max-width:560px; margin:-72px auto 0; position:relative; z-index:2; box-shadow:0 30px 70px rgba(0,0,0,.12); min-height:320px;
  }
  .quiz-q{font-family:var(--mono); font-size:13px; text-transform:uppercase; letter-spacing:.1em; color:var(--red); margin-bottom:10px;}
  .quiz-title{font-family:var(--disp); font-weight:800; font-size:25px; margin-bottom:22px;}
  .quiz-opts{display:grid; gap:11px;}
  .quiz-step{animation:fadeSlide .35s ease;}
  @keyframes fadeSlide{from{opacity:0; transform:translateX(14px);} to{opacity:1; transform:translateX(0);}}
  .quiz-opt{border:1.5px solid var(--g300); border-radius:9px; padding:15px 18px; cursor:pointer; font-weight:600; font-size:15px; display:flex; justify-content:space-between; align-items:center; transition:.15s;}
  .quiz-opt:hover{border-color:var(--red); background:var(--red-pale); transform:translateX(4px);}
  .quiz-opt.selected{border-color:var(--red); background:var(--red-pale); color:var(--red);}
  .quiz-progress-bar{height:5px; background:var(--g200); border-radius:3px; overflow:hidden; margin-bottom:26px;}
  .quiz-progress-bar span{display:block; height:100%; background:var(--red); transition:width .3s ease;}
  .quiz-result{text-align:center; padding:10px 0;}
  .qr-icon{font-size:46px; margin-bottom:14px;}
  .quiz-result h3{font-family:var(--disp); font-weight:800; font-size:26px; margin-bottom:10px;}
  .quiz-result p{font-size:14.5px; color:var(--g700); margin-bottom:22px; line-height:1.6;}
  .btn{font-weight:700; font-size:15px; padding:16px 28px; border-radius:8px; display:inline-flex; align-items:center; gap:8px; cursor:pointer; border:2px solid var(--g900); transition:.2s;}
  .btn-primary{background:var(--red); color:var(--white); border-color:var(--red);}
  .btn-primary:hover{background:var(--red-dark); border-color:var(--red-dark); transform:translateY(-2px); box-shadow:0 10px 20px rgba(155,13,12,.25);}

  /* ---------- why we ask ---------- */

  @media (max-width:720px){
    .quiz-card{padding:28px 22px; margin-top:-50px;}
    .fyf-stats{gap:20px;}
    .na-card{flex-direction:column; text-align:center; padding:18px;}
  }

</style>
</head>
<body>

<!-- ================= HERO INTRO ================= -->
<section class="fyf-hero">
  <div class="blob blob-a"></div>
  <div class="blob blob-b"></div>
  <div class="wrap fyf-hero-inner">
    <div class="fyf-kicker">
      <span class="stars">★★★★★</span>
      <span class="eyebrow" style="color:#ffd4d2;">Find Your Fit</span>
    </div>
    <h1>Built with our<br>nutritionist. For you.</h1>
    <p>A few honest questions about your goals, your days, and your sleep then a real 1:1 with a professional, not a product pushed at you.</p>

    <div class="na-card">
      <div class="na-avatar">⚕️</div>
      <div>
        <div class="na-name">Natalie Gan <span class="na-check">✓ Verified</span></div>
        <div class="na-cred">BSc (Hons) Dietetics with Nutrition</div>
      </div>
    </div>

    <div class="fyf-stats">
      <div class="fyf-stat"><div class="n">2 min</div><div class="l">To complete</div></div>
      <div class="fyf-stat"><div class="n">6</div><div class="l">Quick questions</div></div>
      <div class="fyf-stat"><div class="n">$0</div><div class="l">No obligation</div></div>
    </div>
  </div>
</section>

<!-- ================= QUIZ ================= -->
<section class="fyf-quiz-section">
  <div class="wrap">
    <div class="quiz-card" id="quizCard"><!-- rendered by renderQuizStep() --></div>
  </div>
</section>

<script>
  // ---------- nutritionist quiz engine (same logic as the homepage lightbox) ----------
  const quizGoalMap = {
    burnfat:   {label:"Burn fat faster",                   points:{max:3, maxplus:3}},
    appetite:  {label:"Control appetite / eat less",       points:{fatburner:3, mealrep:3}},
    bloat:     {label:"Feel less bloated / lighter",       points:{debloat:4}},
    energy:    {label:"Boost energy during the day",       points:{maxplus:3}},
    digestion: {label:"Support smooth digestion",          points:{detox:3}},
    replace:   {label:"Replace a meal / stay full longer", points:{mealrep:4}},
    sleepgoal: {label:"Sleep better / wind down at night",  points:{nightfb:3, nighthc:3}}
  };
  const quizRhythmMap = {
    active_day:   {label:"Regular daytime hours, fairly active",         points:{}},
    desk_day:     {label:"Regular daytime hours, mostly desk-based",     points:{max:1, maxplus:1}},
    night_shift:  {label:"Night shifts / rotating shifts",               points:{mealrep:1}},
    changes_alot: {label:"Schedule changes a lot",                       points:{mealrep:1}},
    home_steady:  {label:"Home-based, steady routine",                   points:{}}
  };
  const quizEatingMap = {
    skip:    {label:"I often skip meals or eat irregularly",  points:{mealrep:1}},
    snack:   {label:"I snack when I'm bored or stressed",     points:{slimdrink:1, fatburner:1, max:1}},
    // Late-night eating: deprioritise Max (caffeine + thermogenesis may disrupt sleep),
    // boost NFB + NHC for sleep support, add De-Bloat for digestive comfort
    late:    {label:"I tend to eat late at night",            points:{nightfb:2, nighthc:2, debloat:1, max:-1}},
    noclear: {label:"No clear pattern",                       points:{mealrep:1}}
  };
  const quizSleepMap = {
    // Sleep well: NFB gets stronger push than NHC stronger sleep-support formulation per nutritionist
    sleepwell:  {label:"I sleep well",                            points:{nightfb:2, nighthc:1}},
    fallasleep: {label:"I have trouble falling asleep",           points:{nightfb:3, nighthc:2, max:-2, maxplus:-2}},
    // Wake often: NFB is primary (better efficacy + RTD convenience vs preparing hot choc before bed),
    // deprioritise Max/Max+ at night
    wakeoften:  {label:"I wake up often during the night",        points:{nightfb:3, nighthc:1, max:-2, maxplus:-2}}
  };
  const quizConsiderationMap = {
    // Caffeine sensitivity: still a hard exclusion user told us they're sensitive
    caffeine: {label:"Sensitive to caffeine", exclude:["slimdrink","fatburner","max","maxplus"], reason:"caffeine sensitivity", points:{}},
    // Medical: soft awareness only no hard flags, no exclusions. Nutritionist handles during consultation.
    medical:  {label:"Heart / kidney / thyroid condition, diabetes, or high blood pressure", points:{}, softNote:true},
    stomach:  {label:"Sensitive stomach, IBS, acid reflux, or bloating issues", points:{fatburner:-3, detox:-3, debloat:3}},
    // Anxiety/sleep disorder: remove caffeinated exclusion at the form level nutritionist advises in consultation
    anxiety:  {label:"Anxiety, panic disorder, or a diagnosed sleep disorder", points:{nightfb:2, nighthc:2}, softNote:true},
    // Vegan: flag only, no exclusions
    vegan:    {label:"Vegan / vegetarian", points:{}, softNote:true},
    // Lactose: hard exclusion for meal rep and NHC they genuinely cannot consume these
    lactose:  {label:"Lactose intolerant", exclude:["mealrep","nighthc"], reason:"lactose intolerance", points:{}},
    none:     {label:"None of the above", points:{}}
  };

  let quizState = {gender:null, pregnant:null, goals:[], rhythm:null, eating:null, sleep:null, considerations:[]};
  let quizStepName = 'gender';
  const quizStepOrder = ['gender','pregnant','goal','rhythm','eating','sleep','considerations','result'];

  function quizProgressPct(){
    const visibleSteps = quizState.gender==='female' ? quizStepOrder : quizStepOrder.filter(s=>s!=='pregnant');
    const idx = visibleSteps.indexOf(quizStepName);
    return Math.round(((idx+1)/visibleSteps.length)*100);
  }

  function optButtons(map, selectedArr, onClickFn, multi){
    return Object.keys(map).map(key=>{
      const isSel = multi ? selectedArr.includes(key) : selectedArr===key;
      return `<div class="quiz-opt${isSel?' selected':''}" onclick="${onClickFn}('${key}')">${map[key].label}${isSel?' <span>✓</span>':''}</div>`;
    }).join('');
  }

  function renderQuizStep(){
    const card = document.getElementById('quizCard');
    const pct = quizProgressPct();
    const progressBar = `<div class="quiz-progress-bar"><span style="width:${pct}%"></span></div>`;

    if(quizStepName === 'gender'){
      card.innerHTML = progressBar + `
        <div class="quiz-q">Question 1</div>
        <div class="quiz-title">What's your gender?</div>
        <div class="quiz-opts">
          <div class="quiz-opt" onclick="quizAnswerGender('female')">Female</div>
          <div class="quiz-opt" onclick="quizAnswerGender('male')">Male</div>
        </div>`;
    } else if(quizStepName === 'pregnant'){
      card.innerHTML = progressBar + `
        <div class="quiz-q">Just to be safe</div>
        <div class="quiz-title">Are you currently pregnant or breastfeeding?</div>
        <div class="quiz-opts">
          <div class="quiz-opt" onclick="quizAnswerPregnant('yes')">Yes</div>
          <div class="quiz-opt" onclick="quizAnswerPregnant('no')">No</div>
        </div>`;
    } else if(quizStepName === 'goal'){
      card.innerHTML = progressBar + `
        <div class="quiz-q">Question 2 · Pick up to 2</div>
        <div class="quiz-title">What's your main goal right now?</div>
        <div class="quiz-opts">${optButtons(quizGoalMap, quizState.goals, 'quizToggleGoal', true)}</div>
        <button class="btn btn-primary" style="width:100%; justify-content:center; margin-top:16px;" onclick="quizAdvanceFrom('goal')" ${quizState.goals.length===0?'disabled style="opacity:.4;"':''}>Continue</button>`;
    } else if(quizStepName === 'rhythm'){
      card.innerHTML = progressBar + `
        <div class="quiz-q">Question 3</div>
        <div class="quiz-title">What's your daily rhythm like?</div>
        <div class="quiz-opts">${optButtons(quizRhythmMap, quizState.rhythm, 'quizAnswerRhythm', false)}</div>`;
    } else if(quizStepName === 'eating'){
      card.innerHTML = progressBar + `
        <div class="quiz-q">Question 4</div>
        <div class="quiz-title">Which sounds most like you?</div>
        <div class="quiz-opts">${optButtons(quizEatingMap, quizState.eating, 'quizAnswerEating', false)}</div>`;
    } else if(quizStepName === 'sleep'){
      card.innerHTML = progressBar + `
        <div class="quiz-q">Question 5</div>
        <div class="quiz-title">How's your sleep most nights?</div>
        <div class="quiz-opts">${optButtons(quizSleepMap, quizState.sleep, 'quizAnswerSleep', false)}</div>`;
    } else if(quizStepName === 'considerations'){
      card.innerHTML = progressBar + `
        <div class="quiz-q">Last one · Select all that apply</div>
        <div class="quiz-title">Anything we should know?</div>
        <div class="quiz-opts">${optButtons(quizConsiderationMap, quizState.considerations, 'quizToggleConsideration', true)}</div>
        <button class="btn btn-primary" style="width:100%; justify-content:center; margin-top:16px;" onclick="quizComputeResult()">See My Recommendation</button>`;
    }
  }

  function quizAnswerGender(g){
    quizState.gender = g;
    quizStepName = (g==='female') ? 'pregnant' : 'goal';
    renderQuizStep();
  }
  function quizAnswerPregnant(a){
    quizState.pregnant = a;
    if(a==='yes'){
      document.getElementById('quizCard').innerHTML = `
        <div class="quiz-result">
          <h3>Let's hold off for now</h3>
          <p>Thanks for your honesty we'd recommend holding off on our products for now and checking in with your doctor. Feel free to come back anytime!</p>
        </div>`;
      return;
    }
    quizStepName = 'goal';
    renderQuizStep();
  }
  function quizToggleGoal(key){
    const i = quizState.goals.indexOf(key);
    if(i>-1){ quizState.goals.splice(i,1); }
    else if(quizState.goals.length<2){ quizState.goals.push(key); }
    renderQuizStep();
  }
  function quizAdvanceFrom(step){
    if(step==='goal' && quizState.goals.length===0) return;
    quizStepName = 'rhythm';
    renderQuizStep();
  }
  function quizAnswerRhythm(key){ quizState.rhythm = key; quizStepName='eating'; renderQuizStep(); }
  function quizAnswerEating(key){ quizState.eating = key; quizStepName='sleep'; renderQuizStep(); }
  function quizAnswerSleep(key){ quizState.sleep = key; quizStepName='considerations'; renderQuizStep(); }
  function quizToggleConsideration(key){
    if(key==='none'){ quizState.considerations = quizState.considerations.includes('none') ? [] : ['none']; renderQuizStep(); return; }
    let arr = quizState.considerations.filter(c=>c!=='none');
    const i = arr.indexOf(key);
    if(i>-1) arr.splice(i,1); else arr.push(key);
    quizState.considerations = arr;
    renderQuizStep();
  }

  function quizComputeResult(){
    const goalLabels = quizState.goals.map(g=>quizGoalMap[g] ? quizGoalMap[g].label : '').filter(Boolean);
    const goalSummary = goalLabels.length ? goalLabels.join(' + ') : 'your goals';

    // Map quiz goals → Calendly a1 checkbox values
    const goalToCalendly = { fatburn:'Lose weight', leanmuscle:'Tone up', energy:'Boost energy' };
    const a1Values = quizState.goals.filter(g=>goalToCalendly[g]).map(g=>goalToCalendly[g]);
    if(quizState.considerations.includes('medical')) a1Values.push('Manage a health condition');

    // Build a5 summary for the nutritionist
    const rhythmLabel  = quizState.rhythm && quizRhythmMap[quizState.rhythm]           ? quizRhythmMap[quizState.rhythm].label           : '';
    const eatingLabel  = quizState.eating && quizEatingMap[quizState.eating]             ? quizEatingMap[quizState.eating].label             : '';
    const sleepLabel   = quizState.sleep  && quizSleepMap[quizState.sleep]               ? quizSleepMap[quizState.sleep].label               : '';
    const considLabels = quizState.considerations.filter(c=>c!=='none'&&quizConsiderationMap[c]).map(c=>quizConsiderationMap[c].label);
    const summaryParts = [];
    if(quizState.gender)       summaryParts.push('Gender: '+quizState.gender);
    if(goalLabels.length)      summaryParts.push('Goals: '+goalLabels.join(', '));
    if(rhythmLabel)            summaryParts.push('Rhythm: '+rhythmLabel);
    if(eatingLabel)            summaryParts.push('Eating: '+eatingLabel);
    if(sleepLabel)             summaryParts.push('Sleep: '+sleepLabel);
    if(considLabels.length)    summaryParts.push('Health notes: '+considLabels.join(', '));
    const a5Summary = 'Quiz answers — ' + summaryParts.join(' | ');

    // Build pre-filled Calendly URL
    const params = new URLSearchParams();
    a1Values.forEach(v => params.append('a1', v));
    params.set('a5', a5Summary);
    const CALENDLY_URL = 'https://calendly.com/nutritionist-consult-shortcutx/15min?' + params.toString();

    // Surface any softNote considerations so the nutritionist sees them at the consultation
    const softNotes = quizState.considerations
      .filter(c => quizConsiderationMap[c] && quizConsiderationMap[c].softNote)
      .map(c => quizConsiderationMap[c].label);
    const softNoteHtml = softNotes.length
      ? `<p style="font-family:var(--mono); font-size:12px; color:var(--g700); margin-top:12px; padding:10px 14px; background:var(--g100); border-radius:8px;">Your nutritionist will also discuss: <strong>${softNotes.join('; ')}</strong>.</p>`
      : '';

    const card = document.getElementById('quizCard');
    card.innerHTML = `
      <div class="quiz-result">
        <div class="qr-icon">📅</div>
        <h3>Congratulations on showing up for yourself.</h3>
        <p style="font-size:15.5px; font-weight:600; color:var(--g900); margin-bottom:8px;">That's the hardest part — and you've already done it.</p>
        <p>Based on your answers, we're ready to help you achieve <strong>${goalSummary}</strong>. The best next step is a free 1:1 with our nutritionist, who'll go through your answers and build a plan around your body and your goals.</p>
        ${softNoteHtml}
        <a href="${CALENDLY_URL}" target="_blank" rel="noopener" class="btn btn-primary" style="width:100%; justify-content:center;">Book Your Free Consultation →</a>
        <p style="font-family:var(--mono); font-size:12px; color:var(--g500); margin-top:14px;">15 minutes · No obligation · Singapore time zone</p>
      </div>`;
  }

  renderQuizStep();
</script>

<script id="nav-js">
  // ---------- header shrink on scroll ----------
  window.addEventListener('scroll', ()=>{
    const header = document.getElementById('siteHeader');
    if(window.scrollY > 40) header.classList.add('scrolled');
    else header.classList.remove('scrolled');
  });

  // ---------- mobile menu ----------
  function toggleMobileMenu(){
    document.getElementById('hamburgerBtn').classList.toggle('open');
    document.getElementById('mobileMenu').classList.toggle('open');
  }
  function closeMobileMenu(){
    document.getElementById('hamburgerBtn').classList.remove('open');
    document.getElementById('mobileMenu').classList.remove('open');
  }
</script>
</body>
</html>
