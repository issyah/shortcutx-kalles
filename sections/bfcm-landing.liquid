  /* urgency */
  .hero {
    padding-top: 40px;
    background: radial-gradient(60% 34% at 50% 96%, rgba(226, 35, 26, 0.42), transparent 72%),
      radial-gradient(46% 26% at 50% 38%, rgba(226, 35, 26, 0.13), transparent 72%), var(--k);
  }
  .tag {
    margin-bottom: 16px;
  }
  .hero h1 {
    font-size: clamp(30px, 4.5vw, 60px);
    line-height: 1;
    letter-spacing: -0.015em;
  }
  .cdl {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 22px 0 10px;
    font-size: 13px;
    color: #fff;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--hot);
    animation: dot 1s steps(2, jump-none) infinite;
  }
  @keyframes dot {
    50% {
      opacity: 0.15;
    }
  }
  .cd {
    gap: 12px;
    margin: 0 auto 14px;
    max-width: 1040px;
  }
  .cd div {
    flex: 1;
    width: auto;
    padding: 14px 0 12px;
    border-color: #303030;
    background: linear-gradient(#141414, #0b0b0b);
  }
  .cd b {
    font-size: clamp(46px, 12.4vw, 172px);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .cd span {
    font-size: clamp(9.5px, 1vw, 13px);
  }
  .cd .sec {
    border-color: var(--hot);
    background: linear-gradient(#260605, #120303);
    box-shadow: 0 0 34px rgba(226, 35, 26, 0.3);
  }
  .cd .sec b {
    color: var(--hot);
  }
  .cd b.tk {
    animation: tk 0.3s ease-out;
  }
  @keyframes tk {
    from {
      transform: translateY(-5%);
      opacity: 0.8;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  .tbar {
    height: 5px;
    background: #222;
    max-width: 1040px;
    margin: 0 auto 26px;
    overflow: hidden;
  }
  .tbar i {
    display: block;
    height: 100%;
    background: var(--hot);
    box-shadow: 0 0 14px var(--hot);
    transition: width 1s linear;
  }
  .up {
    margin: 0 0 4px;
    font-size: clamp(22px, 3.3vw, 44px);
  }
  .best {
    margin: 0 0 22px;
  }
  .line-up {
    margin-top: 40px;
  }
  .run {
    background: var(--hot);
    color: #fff;
    overflow: hidden;
    white-space: nowrap;
    font-weight: 900;
    font-size: clamp(16px, 1.9vw, 24px);
    letter-spacing: 0.01em;
    padding: 11px 0;
  }
  .run div {
    display: inline-block;
    animation: run 40s linear infinite;
  }
  @keyframes run {
    to {
      transform: translateX(-50%);
    }
  }
  .deals {
    padding-top: 80px;
  }
  .days {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 36px;
    border: 1px solid var(--g);
  }
  .days > div {
    padding: 14px 18px;
    border-left: 1px solid var(--g);
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 12px;
    align-items: center;
  }
  .days > div:first-child {
    border-left: 0;
  }
  .days small {
    grid-column: 1;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--st);
    text-transform: uppercase;
  }
  .days b {
    grid-column: 1;
    font-weight: 900;
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1;
  }
  .days em {
    grid-column: 2;
    grid-row: 1/3;
    font-style: normal;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: right;
    color: var(--st);
  }
  .days .last {
    background: var(--red);
  }
  .days .last small,
  .days .last em {
    color: #fff;
  }
  .days .gone {
    opacity: 0.32;
  }
  .days .gone b {
    text-decoration: line-through;
  }
  .days .now {
    box-shadow: inset 0 0 0 2px var(--hot);
    background: #1d0403;
  }
  .days .now em {
    color: #fff;
  }
  .bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    background: #0c0c0c;
    border-top: 2px solid var(--hot);
    transform: translateY(110%);
    transition: transform 0.25s;
  }
  .bar.on {
    transform: none;
  }
  .bar .in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 9px 24px;
    max-width: 1180px;
    margin: auto;
  }
  .bar .t {
    font-weight: 700;
    font-size: 13.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .bar .t b {
    font-weight: 900;
    color: var(--hot);
    font-size: 17px;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    margin-left: 6px;
  }
  .bar .btn {
    padding: 10px 22px;
    font-size: 12px;
    flex: none;
  }
  footer {
    padding-bottom: 84px;
  }
  @media (prefers-reduced-motion: reduce) {
    .run div,
    .dot,
    .cd b.tk {
      animation: none;
    }
  }
  @media (max-width: 760px) {
    .hero {
      padding-top: 28px;
    }
    .hero h1 {
      font-size: 8.4vw;
      letter-spacing: -0.02em;
    }
    .cd {
      gap: 6px;
    }
    .cd b {
      font-size: 13.4vw;
    }
    .cd div {
      padding: 10px 0 8px;
    }
    .up {
      font-size: 5.6vw;
      white-space: nowrap;
    }
    .days {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .days > div:nth-child(3) {
      border-left: 0;
    }
    .days > div:nth-child(n + 3) {
      border-top: 1px solid var(--g);
    }
    .days > div {
      padding: 12px;
    }
    .days em {
      font-size: 10.5px;
    }
    .bar .in {
      padding: 8px 12px;
    }
    .bar .t {
      font-size: 11px;
      letter-spacing: 0.04em;
    }
    .bar .t b {
      font-size: 14px;
      margin-left: 3px;
    }
    .bar .btn {
      padding: 9px 12px;
      font-size: 10.5px;
      letter-spacing: 0.08em;
    }
  }
