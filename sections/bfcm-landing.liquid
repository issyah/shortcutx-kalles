{% comment %}BFCM 2026 landing page. Rendered by templates/page.bfcm.liquid (layout none).{% endcomment %}
<style>
  :root {
    --k: #0a0a0a;
    --g: #2a2a2a;
    --hot: #e2231a;
    --red: #980c0c;
    --off: #f5f0e8;
    --st: #b9b2aa;
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--k);
    color: var(--off);
    font: 500 16px/1.6 Montserrat, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  img {
    display: block;
    max-width: 100%;
  }
  a {
    color: inherit;
  }
  h1,
  h2,
  h3 {
    font-weight: 900;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.02;
    letter-spacing: -0.015em;
  }
  .wrap {
    width: min(1180px, 100%);
    margin: auto;
    padding: 0 24px;
    position: relative;
  }
  .lab {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.24em;
    color: var(--hot);
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  h2 {
    font-size: clamp(34px, 5vw, 60px);
  }
  h2 i {
    font-style: normal;
    color: var(--hot);
  }
  section {
    padding: 96px 0;
    position: relative;
  }
  .sub {
    color: var(--st);
    font-size: 17px;
    max-width: 620px;
    margin: 16px 0 0;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--hot);
    color: #fff;
    border: 0;
    padding: 16px 34px;
    font: 700 14px Montserrat;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn:hover {
    background: #ff3a30;
  }
  .btn.line {
    background: transparent;
    box-shadow: inset 0 0 0 1px #6a6a6a;
  }
  .btn.line:hover {
    background: var(--off);
    color: #111;
    box-shadow: none;
  }
  .rl {
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--hot) 14%, #ff6a5e 50%, var(--hot) 86%, transparent);
    box-shadow: 0 0 18px 2px rgba(226, 35, 26, 0.75);
  }
  /* nav */
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(10, 10, 10, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #1c1c1c;
  }
  .nav .wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 64px;
  }
  .nav img {
    height: 22px;
  }
  .nav .btn {
    padding: 10px 18px;
    font-size: 11px;
  }
  /* hero: wording, then products on the stage */
  .hero {
    padding: 56px 0 0;
    text-align: center;
    overflow: hidden;
    background: radial-gradient(60% 42% at 50% 92%, rgba(226, 35, 26, 0.38), transparent 72%), var(--k);
  }
  .tag {
    display: inline-block;
    border: 1px solid var(--hot);
    color: #fff;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.24em;
    padding: 8px 16px;
    margin-bottom: 24px;
  }
  .hero h1 {
    font-size: clamp(46px, 8.6vw, 114px);
    line-height: 0.98;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }
  .hero h1 i {
    font-style: normal;
    color: var(--hot);
  }
  .up {
    font-weight: 900;
    font-size: clamp(22px, 3vw, 38px);
    letter-spacing: 0.02em;
    margin: 20px 0 4px;
  }
  .best {
    font-weight: 500;
    font-size: clamp(16px, 1.6vw, 20px);
    color: var(--off);
    margin: 0;
  }
  .hero .p {
    color: var(--st);
    font-size: 15px;
    margin: 6px auto 0;
    max-width: 560px;
  }
  .cdl {
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.24em;
    color: var(--st);
    text-transform: uppercase;
    margin: 28px 0 10px;
  }
  .cd {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 22px;
  }
  .cd div {
    border: 1px solid var(--g);
    width: 88px;
    padding: 11px 0 8px;
    background: #0f0f0f;
  }
  .cd b {
    display: block;
    font-weight: 900;
    font-size: 36px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .cd span {
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--st);
    text-transform: uppercase;
  }
  form.subf {
    display: flex;
    gap: 0;
    max-width: 520px;
    margin: 0 auto;
  }
  form.subf input {
    flex: 1;
    min-width: 0;
    background: var(--off);
    color: #111;
    border: 0;
    padding: 15px 20px;
    font: 500 15px Montserrat;
  }
  .consent {
    font-size: 11px;
    line-height: 1.5;
    color: #8f8982;
    margin: 10px auto 0;
    max-width: 520px;
  }
  .consent a {
    color: var(--st);
  }
  .fmsg {
    font-size: 14px;
    font-weight: 600;
    margin: 10px 0 0;
    min-height: 1px;
  }
  .line-up {
    position: relative;
    height: clamp(210px, 27vw, 370px);
    margin-top: 44px;
    width: min(1180px, 100%);
    margin-left: auto;
    margin-right: auto;
  }
  .line-up img {
    position: absolute;
    bottom: 0;
    width: auto;
    filter: drop-shadow(0 0 22px rgba(226, 35, 26, 0.42));
    -webkit-box-reflect: below 0 linear-gradient(transparent 80%, rgba(255, 255, 255, 0.2));
  }
  .floor {
    height: clamp(46px, 6vw, 84px);
    background: linear-gradient(#1a0605, #070707);
  }
  /* deals */
  .deals h2 {
    margin-bottom: 6px;
  }
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 44px;
    border: 1px solid var(--g);
  }
  .tier {
    padding: 32px 30px 30px;
    position: relative;
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--g);
  }
  .tier:first-child {
    border-left: 0;
  }
  .tier .who {
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--st);
    text-transform: uppercase;
  }
  .tier .pc {
    font-weight: 900;
    font-size: clamp(88px, 10.5vw, 138px);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 14px 0 0;
  }
  .tier .pc small {
    font-size: 0.44em;
    vertical-align: 0.72em;
    letter-spacing: 0;
  }
  .tier .off {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .tier ul {
    list-style: none;
    margin: 22px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--g);
    font-size: 15px;
    flex: 1;
  }
  .tier li {
    padding: 0 0 8px 20px;
    position: relative;
  }
  .tier li:before {
    content: '+';
    position: absolute;
    left: 0;
    color: var(--hot);
    font-weight: 900;
  }
  .tier li.none {
    padding-left: 0;
    color: var(--st);
  }
  .tier li.none:before {
    content: '';
  }
  .wth {
    display: inline-block;
    align-self: flex-start;
    margin-top: 12px;
    background: var(--red);
    color: #fff;
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px 10px;
  }
  .tier.top {
    background: linear-gradient(180deg, #1d0403, #0d0202);
    box-shadow: inset 0 0 0 1px var(--hot);
  }
  .tier.top .pc {
    color: var(--off);
  }
  .tier.top .who {
    color: #fff;
  }
  .flag {
    position: absolute;
    top: 0;
    right: 0;
    background: var(--hot);
    color: #fff;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.18em;
    padding: 7px 12px;
  }
  .tier.top li {
    padding-right: 74px;
  }
  .pk {
    position: absolute;
    right: 18px;
    bottom: 18px;
    height: 100px;
    width: auto;
    filter: drop-shadow(0 0 16px rgba(226, 35, 26, 0.5));
  }
  .fine {
    font-size: 13px;
    color: var(--st);
    margin: 16px 0 0;
  }
  /* calc */
  .calc {
    margin-top: 28px;
    border: 1px solid var(--g);
    padding: 32px 34px;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  .calc h3 {
    font-size: 26px;
  }
  .calc label {
    display: block;
    font-size: 14px;
    color: var(--st);
    margin: 8px 0 14px;
  }
  .calc output.c {
    font-weight: 900;
    font-size: 50px;
    line-height: 1;
    display: block;
    margin-bottom: 8px;
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--hot);
    height: 28px;
    margin: 0;
  }
  .res .l {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 6px 0;
    font-size: 14.5px;
    color: var(--st);
    border-bottom: 1px solid #1e1e1e;
  }
  .res .l b {
    font-weight: 700;
    color: #fff;
    text-align: right;
  }
  .res .pay {
    font-weight: 900;
    font-size: 32px;
    line-height: 1;
    color: #fff;
  }
  .next {
    margin-top: 12px;
    font-size: 13.5px;
    font-weight: 600;
    color: #ff6a5e;
  }
  /* lifestyle */
  .life {
    padding: 0;
    position: relative;
    overflow: hidden;
    background: #050505;
  }
  .life > img,
  .life picture img {
    width: 100%;
    height: auto;
  }
  .life .copy {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: min(46%, 600px);
    padding: 56px 0 0 max(24px, calc((100vw - 1180px) / 2 + 24px));
    display: flex;
    flex-direction: column;
  }
  .life .lock {
    font-weight: 900;
    font-size: clamp(22px, 2.7vw, 38px);
    line-height: 1;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }
  .life .lock i {
    font-style: normal;
    color: var(--hot);
  }
  .life .lu {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.14em;
    margin-top: 8px;
  }
  .life h2 {
    font-size: clamp(28px, 3.9vw, 54px);
    margin-top: auto;
  }
  .band {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--red);
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    padding: 13px 24px 13px max(24px, calc((100vw - 1180px) / 2 + 24px));
  }
  .life h2 {
    margin-bottom: calc(52px + clamp(16px, 3vw, 40px));
  }
  .life .packs {
    position: absolute;
    right: max(20px, calc((100vw - 1180px) / 2 + 24px));
    bottom: 12px;
    display: flex;
    align-items: flex-end;
    gap: 0;
    height: clamp(120px, 19vw, 250px);
  }
  .life .packs img {
    height: 100%;
    width: auto;
    filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.7));
  }
  .life .packs img + img {
    margin-left: -14%;
    height: 92%;
  }
  /* reviews */
  .score {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: 14px;
    font-weight: 600;
    font-size: 15px;
  }
  .stars {
    color: var(--hot);
    letter-spacing: 0.12em;
  }
  .rg {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 38px;
  }
  .rc {
    border: 1px solid var(--g);
    padding: 24px;
    display: flex;
    flex-direction: column;
  }
  .rc q {
    quotes: none;
    display: block;
    font-size: 16px;
    line-height: 1.5;
    margin: 10px 0 16px;
    flex: 1;
  }
  .rc b {
    font-size: 13.5px;
    font-weight: 700;
  }
  .rc small {
    display: block;
    color: var(--st);
    font-size: 12px;
  }
  /* faq */
  details {
    border-bottom: 1px solid var(--g);
    padding: 17px 0;
  }
  summary {
    font-weight: 700;
    font-size: 17px;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 14px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:after {
    content: '+';
    color: var(--hot);
    font-weight: 900;
  }
  details[open] summary:after {
    content: '−';
  }
  details p {
    color: var(--st);
    margin: 8px 0 0;
    max-width: 760px;
    font-size: 15px;
  }
  .faq {
    padding-top: 0;
  }
  .faq .wrap {
    max-width: 900px;
  }
  /* bundles at the bottom */
  .bun {
    background: #050505;
    border-top: 1px solid #1c1c1c;
  }
  .art {
    position: relative;
    overflow: hidden;
    background: radial-gradient(70% 50% at 50% 84%, rgba(226, 35, 26, 0.36), transparent 74%), #080808;
  }
  .art .ln {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 17%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--hot) 18%, #ff6a5e 50%, var(--hot) 82%, transparent);
    box-shadow: 0 0 14px 1px rgba(226, 35, 26, 0.7);
    z-index: 1;
  }
  .art .fl {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 17%;
    background: linear-gradient(#190605, #060606);
  }
  .art img {
    position: absolute;
    bottom: 17%;
    width: auto;
    z-index: 2;
    filter: drop-shadow(0 0 12px rgba(226, 35, 26, 0.4));
  }
  .feat {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    border: 1px solid var(--g);
    margin-top: 40px;
  }
  .feat .art {
    min-height: 520px;
  }
  .feat .in {
    padding: 38px 38px 34px;
    border-left: 1px solid var(--g);
  }
  .feat h3 {
    font-size: clamp(30px, 3.6vw, 46px);
  }
  .flagi {
    display: inline-block;
    background: var(--hot);
    color: #fff;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.18em;
    padding: 6px 10px;
    margin-bottom: 14px;
  }
  .dn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin: 22px 0;
  }
  .dn b {
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--hot);
    display: block;
    margin-bottom: 6px;
  }
  .dn h4 {
    font-weight: 700;
    font-size: 15px;
    margin: 0 0 4px;
  }
  .dn p {
    margin: 0;
    font-size: 13.5px;
    color: var(--st);
    line-height: 1.5;
  }
  .pr {
    display: flex;
    align-items: flex-end;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 4px;
  }
  .pr .now {
    font-weight: 900;
    font-size: 58px;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .pr .was {
    color: var(--st);
    padding-bottom: 6px;
    font-size: 14px;
  }
  .gf {
    font-weight: 600;
    margin: 0 0 20px;
    font-size: 15px;
  }
  .upl {
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid var(--g);
    font-size: 14px;
    color: var(--st);
    line-height: 1.5;
  }
  .upl b {
    color: #fff;
    font-weight: 700;
  }
  .grid4 {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 14px;
  }
  .card {
    border: 1px solid var(--g);
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s;
  }
  .card:hover {
    border-color: var(--hot);
  }
  .card .art {
    aspect-ratio: 1/0.92;
  }
  .card .in {
    padding: 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .card h3 {
    font-size: 18px;
  }
  .card p {
    font-size: 13px;
    color: var(--st);
    margin: 8px 0 14px;
    line-height: 1.5;
    flex: 1;
  }
  .card .now {
    font-weight: 900;
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .card .was {
    font-size: 12.5px;
    color: var(--st);
    margin: 6px 0 2px;
  }
  .card .tg {
    font-size: 12.5px;
    font-weight: 600;
    color: #ff6a5e;
    margin-bottom: 14px;
    min-height: 19px;
  }
  .card .btn {
    padding: 12px 14px;
    font-size: 11.5px;
  }
  footer {
    padding: 24px 0;
    font-size: 12px;
    color: #8f8982;
    text-align: center;
    border-top: 1px solid #1c1c1c;
  }
  [data-show] {
    display: none;
  }
  .rv {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s, transform 0.7s;
  }
  .rv.on {
    opacity: 1;
    transform: none;
  }
  .mob {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .rv {
      opacity: 1;
      transform: none;
      transition: none;
    }
    html {
      scroll-behavior: auto;
    }
  }
  @media (max-width: 980px) {
    .grid4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .rg,
    .tiers,
    .calc,
    .feat {
      grid-template-columns: minmax(0, 1fr);
    }
    .tier {
      border-left: 0;
      border-top: 1px solid var(--g);
    }
    .tier:first-child {
      border-top: 0;
    }
    .calc {
      padding: 26px 20px;
      gap: 22px;
    }
    .feat .in {
      border-left: 0;
      border-top: 1px solid var(--g);
      padding: 26px 20px;
    }
    .feat .art {
      min-height: 0;
      aspect-ratio: 1/0.85;
    }
  }
  @media (max-width: 760px) {
    section {
      padding: 64px 0;
    }
    .wrap {
      padding: 0 16px;
    }
    .hero {
      padding-top: 36px;
    }
    .hero h1 {
      font-size: 9.9vw;
      white-space: nowrap;
      letter-spacing: -0.03em;
    }
    .up {
      font-size: 24px;
    }
    .line-up {
      height: 60vw;
      margin-top: 34px;
    }
    .line-up .a,
    .line-up .g,
    .line-up .c {
      display: none;
    }
    .line-up .b {
      left: 1% !important;
      height: 72% !important;
    }
    .line-up .d {
      left: 27% !important;
      height: 92% !important;
    }
    .line-up .e {
      left: 60% !important;
      height: 64% !important;
      z-index: 5 !important;
    }
    .line-up .f {
      left: 71% !important;
      height: 82% !important;
    }
    .cd div {
      flex: 1;
      width: auto;
    }
    .cd b {
      font-size: 30px;
    }
    form.subf {
      flex-direction: column;
      gap: 8px;
    }
    form.subf .btn {
      width: 100%;
    }
    .dn {
      grid-template-columns: minmax(0, 1fr);
    }
    .sub {
      font-size: 15.5px;
    }
    .grid4 {
      gap: 10px;
    }
    .card .in {
      padding: 12px;
    }
    .card h3 {
      font-size: 15px;
    }
    .card .now {
      font-size: 25px;
    }
    .card .btn {
      padding: 11px 6px;
      font-size: 10.5px;
      letter-spacing: 0.1em;
    }
    .life {
      padding: 0;
    }
    .life .copy {
      position: absolute;
      width: 100%;
      padding: 32px 16px 0;
      text-align: center;
      display: block;
    }
    .life h2 {
      position: absolute;
      left: 16px;
      right: 44%;
      bottom: 0;
      margin: 0 0 92px;
      text-align: left;
      font-size: 25px;
    }
    .band {
      padding: 11px 47% 11px 16px;
      font-size: 13px;
      min-height: 62px;
      display: flex;
      align-items: center;
    }
