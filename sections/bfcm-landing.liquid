<script>
  /* Klaviyo: paste the list ID for BFCM sign-ups. Sign-ups stay off until it is set. */
  var KLAVIYO_COMPANY = 'Yw2TPM',
    KLAVIYO_LIST = 'Rs98dX'; /* DD | Newsletter */
  var START = new Date('2026-11-27T00:00:00+08:00'),
    END = new Date('2026-11-30T23:59:59+08:00');
  /* Preview other states with ?state=soon, ?state=live or ?state=ended */
  var q = new URLSearchParams(location.search).get('state'),
    now = new Date();
  var STATE = q === 'soon' || q === 'live' || q === 'ended' ? q : now < START ? 'soon' : now <= END ? 'live' : 'ended';
  document.querySelectorAll('[data-show]').forEach(function (e) {
    if (e.getAttribute('data-show').split(' ').indexOf(STATE) > -1) {
      e.style.display = e.tagName === 'A' ? 'inline-flex' : e.classList.contains('tag') ? 'inline-block' : 'block';
    }
  });
  document.querySelectorAll('[data-link]').forEach(function (a) {
    if (STATE === 'live') {
      a.href = 'https://shortcutx.co/cart/' + a.dataset.var + ':1';
      a.textContent = a.dataset.live;
    } else {
      a.href = 'https://shortcutx.co/products/' + a.dataset.link;
      a.textContent = a.dataset.soon;
    }
  });
  var target = STATE === 'soon' ? START : END;
  var FROM = STATE === 'soon' ? new Date('2026-11-04T00:00:00+08:00') : START;
  var DAY = +new URLSearchParams(location.search).get('day');
  var dayIdx = DAY ? DAY - 1 : STATE === 'live' ? Math.min(3, Math.floor((new Date() - START) / 864e5)) : -1;
  var lastDay = STATE === 'live' && dayIdx === 3;
  document.getElementById('cdl').textContent =
    STATE === 'soon' ? 'Promo starts in' : lastDay ? 'Last day. Ends in' : 'Ends in';
  var cdEl = document.getElementById('days');
  if (STATE !== 'soon') {
    [].forEach.call(cdEl.children, function (e, i) {
      if (STATE === 'ended' || i < dayIdx) e.classList.add('gone');
      else if (i === dayIdx) {
        e.classList.add('now');
        if (i < 3) e.querySelector('em').textContent = 'Today';
      }
    });
  }
  var rt =
    STATE === 'soon'
      ? '4 DAYS ONLY  »  27 - 30 NOV  »  UP TO 25% OFF  »  SET YOUR REMINDER  »  '
      : lastDay
      ? 'LAST DAY  »  ENDS TONIGHT  »  UP TO 25% OFF  »  '
      : 'ON NOW  »  ENDS 30 NOV  »  UP TO 25% OFF  »  ';
  if (STATE === 'ended') rt = 'BFCM HAS ENDED  »  THANKS FOR SHOPPING WITH US  »  ';
  document.getElementById('run').textContent = rt.repeat(10);
  var bc = document.getElementById('bc'),
    tb = document.getElementById('tb'),
    bb = document.getElementById('bb');
  document.getElementById('bl').textContent = STATE === 'soon' ? 'Promo starts in' : 'Ends in';
  bb.textContent = STATE === 'soon' ? 'Remind me' : 'Shop now';
  if (STATE === 'live') bb.href = '#bundles';
  var d = document.getElementById('d'),
    h = document.getElementById('h'),
    m = document.getElementById('m'),
    s = document.getElementById('s');
  function p(n) {
    return String(n).padStart(2, '0');
  }
  function tick() {
    var t = Math.max(0, target - new Date());
    d.textContent = p(Math.floor(t / 864e5));
    h.textContent = p(Math.floor(t / 36e5) % 24);
    m.textContent = p(Math.floor(t / 6e4) % 60);
    s.textContent = p(Math.floor(t / 1e3) % 60);
    s.classList.remove('tk');
    void s.offsetWidth;
    s.classList.add('tk');
    bc.textContent =
      Math.floor(t / 864e5) +
      'D ' +
      p(Math.floor(t / 36e5) % 24) +
      'H ' +
      p(Math.floor(t / 6e4) % 60) +
      'M ' +
      p(Math.floor(t / 1e3) % 60) +
      'S';
    tb.style.width = Math.max(0, Math.min(100, (t / (target - FROM)) * 100)) + '%';
    if (t === 0 && !q && STATE !== 'ended') location.reload();
  }
  if (STATE !== 'ended') {
    tick();
    setInterval(tick, 1000);
  }
  var cart = document.getElementById('cart');
  function money(n) {
    return '$' + (Math.round(n * 100) / 100).toFixed(2).replace(/\.00$/, '');
  }
  function calc() {
    var c = +cart.value,
      a = c * 0.85,
      r = a >= 220 ? 25 : a >= 150 ? 20 : 15;
    document.getElementById('co').textContent = '$' + c;
    document.getElementById('rt').textContent = r + '% off storewide';
    document.getElementById('rp').textContent = money((c * (100 - r)) / 100);
    document.getElementById('rg').textContent =
      r === 25 ? 'Detox + $15 credit' : r === 20 ? 'Detox + $10 credit' : 'None yet';
    var need = r === 25 ? 0 : Math.ceil((r === 20 ? 220 : 150) / 0.85 - c);
    document.getElementById('rn').textContent =
      r === 25
        ? "You've unlocked the best deal."
        : 'Add $' +
          need +
          ' more to unlock ' +
          (r === 20 ? '25% off, a free Detox and $15 credit.' : '20% off, a free Detox and $10 credit.');
  }
  cart.addEventListener('input', calc);
  calc();
  var f = document.getElementById('f'),
    fm = document.getElementById('fm');
  f.addEventListener('submit', function (e) {
    e.preventDefault();
    var em = document.getElementById('em').value.trim();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em)) {
      fm.textContent = 'Please enter a valid email.';
      return;
    }
    var framed = true;
    try {
      framed = window.self !== window.top;
    } catch (x) {}
    if (framed) {
      fm.textContent = 'Preview only: sign-ups will save once this page is online.';
      return;
    }
    fm.textContent = 'Saving...';
    fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + KLAVIYO_COMPANY, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', revision: '2024-10-15' },
      body: JSON.stringify({
        data: {
          type: 'subscription',
          attributes: {
            profile: { data: { type: 'profile', attributes: { email: em } } },
            custom_source: 'BFCM 2026 landing page',
          },
          relationships: { list: { data: { type: 'list', id: KLAVIYO_LIST } } },
        },
      }),
    })
      .then(function (r) {
        if (!r.ok) throw 0;
        f.reset();
        fm.textContent = "You're on the list. We'll email you before the promo starts.";
      })
      .catch(function () {
        fm.textContent = 'Something went wrong. Please try again.';
      });
  });
  var bar = document.getElementById('bar'),
    heroEl = document.querySelector('.hero .wrap');
  function barCheck() {
    bar.classList.toggle('on', heroEl.getBoundingClientRect().bottom < 60);
  }
  if (STATE !== 'ended') {
    addEventListener('scroll', barCheck, { passive: true });
    addEventListener('resize', barCheck);
    barCheck();
  }
  bb.addEventListener('click', function (e) {
    if (STATE === 'soon') {
      e.preventDefault();
      window.scrollTo(0, 0);
      document.getElementById('em').focus({ preventScroll: true });
    }
  });
  var io =
    'IntersectionObserver' in window
      ? new IntersectionObserver(
          function (es) {
            es.forEach(function (x) {
              if (x.isIntersecting) {
                x.target.classList.add('on');
                io.unobserve(x.target);
              }
            });
          },
          { threshold: 0.1 }
        )
      : null;
  document.querySelectorAll('.rv').forEach(function (e) {
    io ? io.observe(e) : e.classList.add('on');
  });
</script>

